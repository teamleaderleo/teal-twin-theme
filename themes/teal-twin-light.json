// Teal Twin Light: the light companion. Teal #39C5BB is the selection, a deeper teal the accent
// (so it reads as text), pink the cursor. Every text color in the terminal palette is 4.5:1 or more on
// the background (WCAG AA), except the two "white" slots, which are for backgrounds.
{
  "name": "Teal Twin Light",
  "description": "Teal and pink on a pale mint-white.",

  // The terminal theme these colors edit; every color below replaces its own.
  "appearance.theme": "Builtin Light",
  "colors": {
    "background": "#f7fcfb",
    "foreground": "#1a2e31",
    "cursor": "#e12885",
    "selection": "#39c5bb",
    "accent": "#0a766f",
    "palette": [
      "#2c3e41", "#c8283f", "#1f7a3d", "#8a6400", "#1f63b8", "#c2185f", "#0a766f", "#b8ccc9",
      "#5e7377", "#a81f33", "#18642f", "#6e5000", "#174e93", "#a3134f", "#086158", "#e4f0ee"
    ]
  },
  // Selection, focus and the Send button take the theme's own teal.
  "appearance.accent": "theme",

  // No wallpaper; a pale teal sidebar beside the terminals.
  "appearance.background": "none",
  "appearance.sidebarSurface": "separate",
  "appearance.surfaces.sidebar.color": "#e4f5f3",
  "appearance.surfaces.sidebar.opacity": 1,
  "appearance.surfaces.terminal.color": "#f7fcfb",
  "appearance.surfaces.terminal.opacity": 1,

  // The pink accent: the mark that shows an agent at work.
  "appearance.statusIndicator.color": "#e12885"
}
