// Teal Twin Dark: teal #39C5BB on a deep teal-black, with a pink accent.
// Every text color in the terminal palette is 4.5:1 or more on the background (WCAG AA).
{
  "name": "Teal Twin Dark",
  "description": "Teal on a deep teal-black, with a pink accent.",

  // The terminal theme these colors edit; every color below replaces its own.
  "appearance.theme": "Builtin Dark",
  "colors": {
    "background": "#0e1719",
    "foreground": "#ddf3f0",
    "cursor": "#ff7eb9",
    "selection": "#1f4b4a",
    "accent": "#39c5bb",
    "palette": [
      "#1b2a2d", "#ff6b81", "#7fd99a", "#f2d479", "#6cb6ff", "#ff7eb9", "#39c5bb", "#c6dcd9",
      "#6f8e92", "#ff8fa0", "#a3ebb6", "#f8e3a0", "#99ccff", "#ffa6cf", "#7de3da", "#f2fbfa"
    ]
  },
  // Selection, focus and the Send button take the theme's own teal.
  "appearance.accent": "theme",

  // No wallpaper; a darker sidebar beside the terminals.
  "appearance.background": "none",
  "appearance.sidebarSurface": "separate",
  "appearance.surfaces.sidebar.color": "#0a1214",
  "appearance.surfaces.sidebar.opacity": 1,
  "appearance.surfaces.terminal.color": "#0e1719",
  "appearance.surfaces.terminal.opacity": 1,

  // The pink accent: the mark that shows an agent at work.
  "appearance.statusIndicator.color": "#ff7eb9"
}
